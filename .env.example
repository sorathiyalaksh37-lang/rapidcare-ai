# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rapidcare:rapidcare123@localhost:5432/rapidcare_db

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── FastAPI ─────────────────────────────────────────────
SECRET_KEY=change-me-in-production-super-secret-key
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Models ───────────────────────────────────────────
# Set to "demo" to skip model downloads and use mock responses
AI_MODE=full          # full | demo
WHISPER_MODEL=small   # tiny | base | small | medium

# ── Optional: OpenAI (enhances LLM responses if provided) ──
OPENAI_API_KEY=       # Leave blank to use fully local models

# ── Google Maps (optional – leave blank to use Leaflet) ─
GOOGLE_MAPS_API_KEY=
