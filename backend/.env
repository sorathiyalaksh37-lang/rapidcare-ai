# ── Database ────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./rapidcare.db

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── FastAPI ─────────────────────────────────────────────
SECRET_KEY=dev-secret-key-rapidcare
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Models ───────────────────────────────────────────
AI_MODE=demo
WHISPER_MODEL=small

# ── Optional OpenAI ─────────────────────────────────────
OPENAI_API_KEY=

# ── Google Maps (optional) ──────────────────────────────
GOOGLE_MAPS_API_KEY=
